PORT=5000
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call this API / connect via Socket.IO.
# Add your ngrok web-tunnel URL here when testing over the internet, e.g.:
# CORS_ORIGIN=http://localhost:3000,https://abcd1234.ngrok-free.app
CORS_ORIGIN=http://localhost:3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/supercall"
JWT_SECRET=change-me
JWT_EXPIRES_IN=10s

JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d
